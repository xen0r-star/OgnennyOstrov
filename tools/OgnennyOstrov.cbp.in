<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
  <FileVersion major="1" minor="6" />
  <Project>
    <Option title="OgnennyOstrov" />
    <Option pch_mode="2" />
    <Option compiler="gcc" />
    <Build>
      <Target title="Client">
        <Option output="bin/Client/Release/OgnennyOstrov" prefix_auto="1" extension_auto="1" />
        <Option working_dir="bin/Client/Release/" />
        <Option object_output="obj/Client/Release/" />
        <Option type="1" />
        <Option compiler="gcc" />
        <Compiler>
          <Add option="-O2" />
        </Compiler>
        <Linker>
          <Add option="-s" />
          <Add library="sfml-graphics" />
          <Add library="sfml-window" />
          <Add library="sfml-network" />
          <Add library="sfml-system" />
          <Add library="sfml-audio" />
        </Linker>
      </Target>
      <Target title="Server">
        <Option output="bin/Server/Release/OgnennyOstrovServer" prefix_auto="1" extension_auto="1" />
        <Option working_dir="bin/Server/Release/" />
        <Option object_output="obj/Server/Release/" />
        <Option type="1" />
        <Option compiler="gcc" />
        <Compiler>
          <Add option="-O2" />
        </Compiler>
        <Linker>
          <Add option="-s" />
          <Add library="sfml-network" />
          <Add library="sfml-system" />
        </Linker>
      </Target>
    </Build>
    <Compiler>
      <Add option="-std=c++17" />
      <Add option="-Wall" />
      <Add directory="src" />
      <Add directory="deps/SFML/include" />
    </Compiler>
    <Linker>
      <Add directory="deps/SFML/lib" />
    </Linker>
    <ExtraCommands>
      <Add after="cmd /c copy /Y deps\SFML\bin\*.dll $(TARGET_OUTPUT_DIR)" />
      <Add after="cmd /c if exist assets xcopy /E /I /Y assets $(TARGET_OUTPUT_DIR)assets" />
    </ExtraCommands>
@@UNITS@@
  </Project>
</CodeBlocks_project_file>